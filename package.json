{
  "name": "blocker-extension",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "ML Blocker + training + FL Training",
  "scripts": {
    "dev": "vite",
    "build": "bun run build:features && tsc -b && vite build",
    "preview": "vite preview",
    "test": "bun run build:features && vitest run",
    "bench": "bun bench/pageload.ts",
    "build:features": "cargo build --release --target wasm32-unknown-unknown --manifest-path features/Cargo.toml && wasm-bindgen --target web --out-dir features/pkg features/target/wasm32-unknown-unknown/release/adflush_features.wasm"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.4.0",
    "@types/chrome": "^0.1.37",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "puppeteer-core": "^25.13.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vite-plugin-zip-pack": "^1.2.4",
    "vitest": "^5.0.3"
  }
}
